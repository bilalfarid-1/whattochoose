# JobPulse Backend Environment Configuration
# Copy this file to .env for local overrides or configure in deployment pipelines

PROJECT_NAME=JobPulse API
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
AUTO_CREATE_TABLES=False

# In production, SECRET_KEY must be a randomly generated token with at least 32 characters
# (e.g. openssl rand -hex 32)
SECRET_KEY=super-secret-development-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection (SQLite default for local dev, PostgreSQL for containerized / production)
DATABASE_URL=sqlite:///./jobpulse.db
# DATABASE_URL=postgresql://jobpulse_user:jobpulse_dev_password@localhost:5432/jobpulse_db

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["*"]
